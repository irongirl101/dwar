<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet href="/pretty-feed-v3.xsl?v=4" type="text/xsl"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  {% set root = site.base_url %}
  {% if '://' not in root %}{% set root = 'https://' ~ root %}{% endif %}
  {% set base = root ~ (site.base_path | default('')) %}

  <title>{{ feed_title | default(site.site_name) }}</title>
  <subtitle>{{ feed_subtitle | default('Posts from ' ~ site.author) }}</subtitle>
  <link href="{{ base }}{{ feed_self_url }}" rel="self" type="application/atom+xml"/>
  <link href="{{ base }}{{ feed_alt_url | default('/') }}" rel="alternate" type="text/html"/>
  <id>{{ base }}{{ feed_alt_url | default('/') }}</id>
  <updated>{{ build_time }}</updated>
  <author>
    <name>{{ site.author }}</name>
  </author>

  {% for entry in feed_entries %}
  <entry>
    <title>{{ entry.title | e }}</title>
    <link href="{{ base }}{{ entry.url }}" rel="alternate" type="text/html"/>
    <id>{{ base }}{{ entry.url }}</id>
    <published>{{ entry.date_iso }}</published>
    <updated>{{ entry.date_iso }}</updated>
    {% if entry.tags %}
    {% for tag in entry.tags %}
    <category term="{{ tag | e }}"/>
    {% endfor %}
    {% endif %}
    {% if entry.description %}
    <summary type="text">{{ entry.description | e }}</summary>
    {% endif %}
    {% if entry.content_html %}
    <content type="html"><![CDATA[{{ entry.content_html }}]]></content>
    {% endif %}
  </entry>
  {% endfor %}
</feed>
